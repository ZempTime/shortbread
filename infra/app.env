# Single source of app-specific values for infra scripts/templates.
# No secrets here — ever.
APP_NAME=shortbread
GITHUB_REPO=ZempTime/shortbread-share
NF_TEAM=zemptimes-team
NF_REGION=us-central
NF_PLAN_WEB=nf-compute-20
NF_PLAN_MIGRATE=nf-compute-10
NF_PLAN_POSTGRES=nf-compute-10
# Owner UI / API. Sites are served from *.sites.$DOMAIN — see SITE_DOMAIN below.
DOMAIN=tater.chriszempel.com
# Added to Northflank as its own wildcard domain. The apex cannot serve a wildcard
# domain, which is why the .sites. infix exists (lib/shortbread/hosts.rb).
SITE_DOMAIN=sites.tater.chriszempel.com
R2_BUCKET=shortbread-blobs
